# Только литеральные несекретные значения. Скопировать в /root/paco/config.env, chmod 0600.
# Код из этих файлов НЕ source/не исполняется. Не используйте $VAR/$(command).
CLIENT_CIDR=10.77.77.0/24
TRANSIT_CIDR=10.88.88.0/30
ENTRY_AWG0_ADDR=10.77.77.1/24
ENTRY_AWG1_ADDR=10.88.88.1/30
EXIT_AWG1_ADDR=10.88.88.2/30
CLIENT_PORT=60333
TRANSIT_PORT=60334
CLIENT_DNS=1.1.1.1
MTU=1380
FIREWALL_BACKEND=iptables-nft
POLICY_TABLE=100
CLIENT_RULE_PREF=100
TRANSIT_RULE_PREF=99
# Текущий клиент / будущий тестовый клиент, должен реально существовать при verify.
TEST_CLIENT_IP=10.77.77.54
ROLLBACK_SECONDS=1800
TRANSIT_PROFILE_FILE=/root/paco/transit-profile.conf
# NONE только если старый AWG1 не использует PSK. Иначе — путь к root:root 0600.
TRANSIT_PSK_FILE=NONE
CLIENT_IPV6_CAPTURE_VERIFIED=NO
CLIENT_POLICY_EVIDENCE=/root/paco/client-ipv6-evidence.json
PROVIDER_FIREWALL_VERIFIED=NO
OFFSITE_BACKUP_VERIFIED=NO
LEGACY_POLICY_AUDITED=NO
# Свежий результат клиента/аварийных тестов и reboot после развёртывания.
ACCEPTANCE_FILE=/root/paco/acceptance.json
