# Два новых VPS. Ничего из публичных IP/hostname A не переносить автоматически.
SCENARIO=B
NODE_ROLE=exit
ENTRY_HOSTNAME=TO_FILL
ENTRY_PUBLIC_IP=TO_FILL
ENTRY_WAN_IF=TO_CONFIRM
ENTRY_OS_DESCRIPTION=TO_CONFIRM
ENTRY_KERNEL=TO_CONFIRM
EXIT_HOSTNAME=TO_FILL
EXIT_PUBLIC_IP=TO_FILL
EXIT_WAN_IF=TO_CONFIRM
EXIT_OS_DESCRIPTION=TO_CONFIRM
EXIT_KERNEL=TO_CONFIRM
SSH_PORT=22
SSH_SOURCE_CIDR=TO_CONFIRM
ENTRY_TRANSIT_PUBLIC_KEY=TO_FILL
EXIT_TRANSIT_PUBLIC_KEY=TO_FILL
# Выбор: RESTORE_FROM_OWNER_BACKUP либо REISSUE_ALL.
CLIENT_IDENTITY_STRATEGY=REISSUE_ALL
# Даже при restore профили клиентов могут требовать нового Endpoint.
CLIENT_ENDPOINT=TO_FILL
# NONE или RESTORE_OFFLINE. Рабочая активация неизвестного исходника менеджера — NO-GO.
MANAGER_MODE=NONE
RESTORE_AWG0_FILE=/root/paco-private/awg0.conf
RESTORE_MANAGER_DIR=/root/paco-private/manager
